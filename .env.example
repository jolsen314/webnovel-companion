# Copy to .env and fill in.

# Postgres (any host — Neon / Vercel Postgres / Supabase). Consumed by Prisma.
# On Neon: `neon env pull` writes DATABASE_URL (pooled) + DATABASE_URL_UNPOOLED (direct).
# We default DATABASE_URL to the DIRECT/unpooled endpoint (single-user app; also correct
# for Prisma migrations) and keep the pooled one as DATABASE_URL_POOLED for later.
DATABASE_URL="postgresql://user:pass@localhost:5432/webnovel_companion"
# DATABASE_URL_POOLED="postgresql://...-pooler.../neondb"   # Neon pooled endpoint (optional)
# DATABASE_URL_UNPOOLED="postgresql://.../neondb"           # Neon direct endpoint (set by env pull)

# Web Push (WP-09). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Same value as VAPID_PUBLIC_KEY, but exposed to the browser for the Slice B subscribe flow.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Headless renderer (WP-17b) — for JS-rendered TOCs. Unset → page-watch is plain-fetch only.
#   RENDER_URL:    the render service's endpoint, e.g. https://renderer.example/render
#   RENDER_SECRET: bearer token the render service checks (optional but recommended)
RENDER_URL=""
RENDER_SECRET=""

# Shared secret for the cron poll endpoint. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". If unset, the endpoint is open (dev only).
CRON_SECRET=""

# Single-user id for the MVP (see CONTEXT.md). Defaults to "local" if unset.
WEBNOVEL_USER_ID=""

# Access gate (WP-AUTH). Both required in production (the gate fails closed without them).
#   AUTH_PASSWORD_HASH:  npm run auth:hash -- "your passphrase"
#   AUTH_SECRET (cookie signing):  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""
