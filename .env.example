# Copy to .env and fill in.

# Postgres (any host — Neon / Vercel Postgres / Supabase). Consumed by Prisma.
DATABASE_URL="postgresql://user:pass@localhost:5432/webnovel_companion"

# Web Push (WP-09). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret for the cron poll endpoint. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". If unset, the endpoint is open (dev only).
CRON_SECRET=""

# Single-user id for the MVP (see CONTEXT.md). Defaults to "local" if unset.
WEBNOVEL_USER_ID=""
