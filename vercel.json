{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude,glob)*.md' ':(exclude)docs/'",
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "src/app/api/render/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
